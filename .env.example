# TGS E-Testing LMS — Vercel environment variables
# Copy these into Vercel: Project Settings → Environment Variables.

# Your MongoDB Atlas connection string.
# Get it from MongoDB Atlas → Connect → "Drivers" → copy the URI,
# replacing <password> with your database user's password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional: the database name inside your cluster. Default: tgs_exam
MONGODB_DB=tgs_exam
